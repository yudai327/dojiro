{
  "name": "dojiro-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "lint": "next lint && eslint app --ext .ts,.tsx",
    "lint:check": "eslint app --ext .ts,.tsx --max-warnings 5",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"prisma/**/*.{ts,tsx}\"",
    "test": "vitest run __tests__/unit.test.ts",
    "test:watch": "vitest __tests__/unit.test.ts",
    "test:ui": "vitest --ui __tests__/unit.test.ts",
    "test:integration": "vitest run __tests__/api.integration.test.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "next": "14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.8.0",
    "@prisma/internals": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/ui": "^4.0.13",
    "eslint": "^8.0.0",
    "happy-dom": "^20.0.10",
    "msw": "^2.12.3",
    "prettier": "^3.6.2",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.13"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
